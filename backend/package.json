{
  "name": "aptimate-backend",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "multer": "$multer"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest --runInBand",
    "ai:writing:smoke": "ts-node scripts/writing-ai-smoke.ts",
    "ai:writing:demo": "ts-node scripts/writing-ai-demo.ts",
    "ai:writing:survey": "ts-node scripts/writing-gemini-survey.ts",
    "ai:writing:backfill": "ts-node scripts/writing-ai-backfill.ts",
    "test:writing": "jest --runInBand --testPathPattern \"writing-assessment|common/ai\"",
    "test:writing:db": "ts-node test/integration/writing-assessment.ts",
    "test:writing:localdb": "ts-node scripts/writing-local-db-test.ts",
    "test:vocabulary:db": "ts-node test/integration/vocabulary-database.ts",
    "test:speaking:cefr:db": "ts-node test/integration/speaking-part-cefr.ts",
    "test:personalization:db": "ts-node test/integration/run-personalization.ts",
    "test:notifications:db": "ts-node test/integration/notification-scheduling.ts",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "test:attempt-load": "ts-node test/performance/shared-attempts-load.ts",
    "db:migrate": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "db:migrate:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "db:migrate:status": "typeorm-ts-node-commonjs migration:show -d src/database/data-source.ts",
    "db:migrate:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "db:seed": "ts-node src/database/seeds/run-seeds.ts",
    "db:seed:samples": "ts-node src/database/seeds/seed-sample-tests.ts",
    "db:seed:expanded": "ts-node src/database/seeds/seed-expanded-tests.ts",
    "seed:expanded:audio": "ts-node scripts/prepare-expanded-audio.ts",
    "test:seed:expanded:db": "ts-node test/integration/expanded-seed.ts",
    "test:roles:db": "ts-node test/integration/account-roles.ts",
    "test:comments:db": "ts-node test/integration/comments-database.ts",
    "test:comments": "jest --runInBand --testPathPattern comments",
    "test:chatbot": "jest --runInBand --testPathPattern chatbot",
    "test:chatbot:db": "ts-node test/integration/chatbot-database.ts",
    "knowledge:validate": "ts-node scripts/chatbot-knowledge.ts --validate",
    "knowledge:import": "ts-node scripts/chatbot-knowledge.ts --apply",
    "ai:chatbot:smoke": "ts-node scripts/chatbot-smoke.ts",
    "test:personalization": "jest --runInBand --testPathPattern personalization",
    "ai:personalization:smoke": "ts-node scripts/personalization-smoke.ts",
    "topics:backfill": "ts-node scripts/topic-backfill.ts",
    "test:topics:db": "ts-node test/integration/personalization-topics.ts",
    "personalization:replan-current": "ts-node scripts/personalization-replan-current.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.6",
    "@types/multer": "^2.2.0",
    "@vvo/tzdb": "^6.198.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "helmet": "^8.1.0",
    "joi": "^18.0.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "typeorm": "^0.3.27",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.3.1",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "prettier": "^3.6.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "setupFiles": [
      "reflect-metadata"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
