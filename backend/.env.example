NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=log

DATABASE_URL=postgresql://aptimate:aptimate@localhost:5433/aptimate
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_SSL=false

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-character-secret
JWT_ISSUER=aptimate-api
JWT_AUDIENCE=aptimate-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

PASSWORD_HASH_ROUNDS=12
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_FIRST_NAME=System
ADMIN_SEED_LAST_NAME=Administrator
PASSWORD_RESET_OTP_TTL_MINUTES=10
PASSWORD_RESET_GRANT_TTL_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5

SMTP_ENABLED=true
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AptiMate <no-reply@aptimate.local>
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_GREETING_TIMEOUT_MS=5000
SMTP_SOCKET_TIMEOUT_MS=10000

# Cloudinary
CLOUDINARY_ENABLED=true
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=aptimate/test-covers
CLOUDINARY_AVATAR_FOLDER=aptimate/avatars
UPLOAD_MAX_FILE_SIZE_BYTES=5242880

# Speaking AI:
SPEAKING_AI_ENABLED=false
GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_PAID_PROJECT_CONFIRMED=false
GEMINI_BILLING_TIER=PAID
GEMINI_FREE_PROJECT_CONFIRMED=false
GROQ_FREE_TIER_CONFIRMED=false
SPEAKING_ADULT_ONLY_CONFIRMED=false
SPEAKING_AI_PRICING_VERIFIED=false
SPEAKING_AI_MONTHLY_BUDGET_USD=1
GEMINI_INPUT_USD_PER_MILLION=0.5
GEMINI_OUTPUT_USD_PER_MILLION=1.5
SPEAKING_FFMPEG_PATH=ffmpeg
SPEAKING_FFPROBE_PATH=ffprobe

# Writing AI uses the existing Gemini key and confirmed FREE tier above.
WRITING_AI_ENABLED=false
WRITING_AI_PROVIDER=gemini
WRITING_AI_MODEL=gemini-3.1-flash-lite
WRITING_AI_REQUEST_TIMEOUT_MS=60000
WRITING_AI_MAX_OUTPUT_TOKENS=8192
WRITING_AI_WORKER_CONCURRENCY=1
WRITING_AI_MIN_INTERVAL_MS=15000
WRITING_AI_MAX_ATTEMPTS=3

# Azure Translator (primary dictionary provider)
AZURE_TRANSLATOR_ENABLED=false
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_TIMEOUT_MS=2500

# Chatbot uses existing Gemini credentials. No automatic paid fallback.
CHATBOT_ENABLED=false
CHATBOT_MODEL=gemini-3.5-flash-lite
# Shared chatbot/personalization client: per model, per process, rolling 60 seconds.
# Application cap only; set within the quota assigned to your Google project.
GEMINI_MAX_RPM=5

# RULE plans and learning progress reconciliation (every 60 seconds; no AI/email).
PERSONALIZATION_WORKER_ENABLED=true
