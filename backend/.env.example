NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=log

DATABASE_URL=postgresql://aptimate:aptimate@localhost:5433/aptimate
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_SSL=false

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-character-secret
JWT_ISSUER=aptimate-api
JWT_AUDIENCE=aptimate-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

PASSWORD_HASH_ROUNDS=12
PASSWORD_RESET_OTP_TTL_MINUTES=10
PASSWORD_RESET_GRANT_TTL_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5

SMTP_ENABLED=true
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AptiMate <no-reply@aptimate.local>
