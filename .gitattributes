# Keep source files identical across Windows, macOS, and Linux.
* text=auto

*.js      text eol=lf
*.jsx     text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.env     text eol=lf
*.example text eol=lf
*.svg     text eol=lf

*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.mp3  binary
*.wav  binary
*.pdf  binary
